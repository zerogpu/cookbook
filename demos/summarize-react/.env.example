# Copy to .env and fill in your ZeroGPU credentials.
# Get them from https://zerogpu.ai (API Keys + Project Settings).
# Never commit .env or expose API keys in production client code.

VITE_ZEROGPU_API_KEY=your_api_key
VITE_ZEROGPU_PROJECT_ID=your_project_id

# Optional: override model (default: zlm-v1-summary-cloud)
# VITE_ZEROGPU_MODEL=zlm-v1-summary-cloud
